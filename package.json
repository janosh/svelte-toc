{
  "name": "svelte-toc",
  "version": "0.7.0",
  "description": "Sticky responsive table of contents component written in Svelte",
  "keywords": [
    "component",
    "headings",
    "navigation",
    "sidebar",
    "svelte",
    "table of contents",
    "toc"
  ],
  "homepage": "https://janosh.github.io/svelte-toc",
  "bugs": "https://github.com/janosh/svelte-toc/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/svelte-toc",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    "./Toc.svelte": {
      "types": "./dist/Toc.svelte.d.ts",
      "svelte": "./dist/Toc.svelte",
      "default": "./dist/Toc.svelte"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test --run && playwright test",
    "package": "svelte-package",
    "prepublishOnly": "pnpm run package",
    "changelog": "npx tsx https://github.com/janosh/workflows/raw/refs/heads/main/scripts/make-release-notes.ts"
  },
  "devDependencies": {
    "@janosh/vite-config": "github:janosh/dotfiles",
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@wooorm/starry-night": "^3.10.0",
    "jsdom": "^30.0.0",
    "mdsvex": "^0.12.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "svelte-multiselect": "^11.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "packageManager": "pnpm@11.9.0"
}
